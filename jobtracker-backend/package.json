{
  "name": "jobtracker-backend",
  "version": "1.0.0",
  "description": "NextRole job search monitoring and AI resume tailoring backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "compile": "tsc",
    "start": "node dist/server.js",
    "worker": "tsx watch worker.ts",
    "worker:start": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "test:scraper": "tsx test-scraper.ts",
    "test:scraper:all": "tsx test-scraper-batch.ts",
    "scraper:health": "tsx -e \"import('./scraper').then(s => s.scrapeJobsWithResult(process.argv[2]).then(r => console.log(JSON.stringify(r, null, 2))))\" --",
    "start:db": "powershell ./start-db.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1049.0",
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.20.0",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^7.2.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.8.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.4",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "robots-parser": "^3.0.1",
    "socket.io": "^4.8.3",
    "typescript": "^5.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.11.0"
  }
}

